# --- แกนหลัก ---
DATABASE_URL=postgresql+asyncpg://sv:sv@postgres:5432/shortvideo
REDIS_URL=redis://redis:6379/0
PUBLIC_URL=http://localhost:8000

# --- providers ---
OPENROUTER_API_KEY=sk-or-v1-xxxxx
# vLLM ของ fatlama-ai — ใช้กับงาน LLM ปริมาณมากโดยไม่เสียเงิน
VLLM_BASE_URL=http://10.0.0.10:8001/v1
# Thai Whisper fine-tune — ตัวที่ทำ word timestamp ให้ timeline
# JaiTTS (F5-TTS) เสียงไทยที่รันเอง
TTS_BASE_URL=http://10.0.0.10:8100
WHISPER_BASE_URL=http://10.0.0.10:8002
# provider ที่รันเอง — ตอนนี้ไม่ได้ใช้แล้ว (ย้ายภาพ/เสียง/ถอดเสียงไป OpenRouter)
# ใส่ค่าพวกนี้ + แก้ routing profile ถ้าจะกลับไปรันบนเครื่อง
IMAGE_BASE_URL=http://10.0.0.10:8102

# --- storage ---
STORAGE_ROOT=/data/runs
S3_ENDPOINT=http://minio:9000
S3_BUCKET=shortvideo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# --- งบ ---
DAILY_BUDGET_USD=20
DEFAULT_TASK_BUDGET_USD=5
EXTERNAL_PROVIDERS_ENABLED=true

# --- โพสต์ (ใส่เฉพาะแพลตฟอร์มที่ใช้) ---
# YouTube: OAuth client ของ Google Cloud (scope youtube.upload) token ต่อบัญชีเก็บใน publish_target
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: แอปใน TikTok for Developers ที่เปิด Content Posting API (scope video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Facebook Reels ไม่ต้องมี env — ใช้ Page access token + page_id ใน publish_target.config
